#include <iostream>

const int CAPACIDAD_PILA = 100;

class Pila {
public:
    Pila();

    bool estaVacia() const;
    bool estaLlena() const;
    bool apilar(int valor);
    bool desapilar();
    int verTope() const;

private:
    int datos[CAPACIDAD_PILA];
    int cima;
};

/**
 * @class GestorPila
 * @brief Administra una Pila de enteros. imprimir y buscar usan recursividad.
 */
class GestorPila {
public:
    GestorPila();

    Pila getPila() const;
    void setPila(Pila newPila);

    void insertar(int valor);
    void eliminar();
    int imprimir();
    bool buscar(int objetivo);

private:
    Pila pila;
};

Pila::Pila() : cima(-1) {
    for (int i = 0; i < CAPACIDAD_PILA; i++) {
        datos[i] = 0;
    }
}

bool Pila::estaVacia() const {
    return cima == -1;
}

bool Pila::estaLlena() const {
    return cima == CAPACIDAD_PILA - 1;
}

bool Pila::apilar(int valor) {
    if (estaLlena()) return false;
    cima++;
    datos[cima] = valor;
    return true;
}

bool Pila::desapilar() {
    if (estaVacia()) return false;
    cima--;
    return true;
}


int Pila::verTope() const {
    if (estaVacia()) return 0;
    return datos[cima];
}


GestorPila::GestorPila() {}

Pila GestorPila::getPila() const {
    return pila;
}

void GestorPila::setPila(Pila newPila) {
    pila = newPila;
}

void GestorPila::insertar(int valor) {
    if (!pila.apilar(valor)) {
        std::cout << "La pila esta llena (maximo " << CAPACIDAD_PILA << " elementos).\n";
    }
}

void GestorPila::eliminar() {
    if (!pila.desapilar()) {
        std::cout << "La pila esta vacia, no hay nada que eliminar.\n";
    }
}

int GestorPila::imprimir() {
    
    if (pila.estaVacia()) return 0;

    // Caso recursivo: se saca el tope, se imprime y se llama de nuevo con el resto.
    int tope = pila.verTope();
    pila.desapilar();
    std::cout << tope << "\n";
    int cantidad = 1 + imprimir();

    pila.apilar(tope);
    return cantidad;
}

bool GestorPila::buscar(int objetivo) {
    // Caso base 1: pila vacia, el objetivo no esta.
    if (pila.estaVacia()) return false;

    int tope = pila.verTope();
    if (tope == objetivo) return true;

    pila.desapilar();
    bool encontrado = buscar(objetivo);

    pila.apilar(tope);
    return encontrado;
}

int main() {
    GestorPila gestor;

    gestor.insertar(10);
    gestor.insertar(20);
    gestor.insertar(30);

    std::cout << "Pila (del tope a la base):\n";
    int cantidad = gestor.imprimir();
    std::cout << "Elementos: " << cantidad << "\n\n";

    std::cout << "Buscar 20: " << (gestor.buscar(20) ? "encontrado" : "no encontrado") << "\n";
    std::cout << "Buscar 99: " << (gestor.buscar(99) ? "encontrado" : "no encontrado") << "\n\n";

    std::cout << "La pila sigue completa despues de buscar e imprimir:\n";
    gestor.imprimir();

    gestor.eliminar();
    std::cout << "\nDespues de eliminar el tope:\n";
    gestor.imprimir();

    Pila otraPila;
    otraPila.apilar(1);
    otraPila.apilar(2);
    gestor.setPila(otraPila);
    std::cout << "\nDespues de setPila:\n";
    gestor.imprimir();

    Pila copia = gestor.getPila();
    std::cout << "\nTope obtenido con getPila: " << copia.verTope() << "\n";

    GestorPila vacio;
    if (vacio.imprimir() == 0) std::cout << "\nLa pila vacia no imprime nada.\n";
    return 0;
}
